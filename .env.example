# PalWorld Server Manager Configuration
# Copy this file to .env and adjust values

HOST=0.0.0.0
PORT=8080

# Password required to access the web UI
AUTH_PASSWORD=palforge

# Directory where server instances are stored
SERVER_DATA_DIR=servers

# Directory where SteamCMD is installed
STEAMCMD_DIR=steamcmd

# Enable CORS for all origins (disable in production if not needed)
CORS_ORIGINS=*

# Log level: debug, info, warning, error
LOG_LEVEL=info
